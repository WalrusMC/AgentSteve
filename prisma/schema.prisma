// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Guild {
  id String @id
  name String
  downloads Download[]
  plugins Plugin[]
  servers Server[]
  users GuildUser[]
}

model Download {
  id Int @id @default(autoincrement())
  file String
  description String

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId String
}

model Plugin {
  id Int @id @default(autoincrement())
  name String
  version String
  description String
  file String

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId String
}

model Server {
  id String @id
  information Json
  consoleHistory ConsoleLine[]

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId String
}

model ConsoleLine {
  id Int @id @default(autoincrement())
  createdAt DateTime @default(now())
  line String

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId String
  @@index([serverId, createdAt])
}

model GuildUser {
  id Int @id @default(autoincrement())

  token Json?

  userId String

  guild Guild @relation(fields: [guildId], references: [id])
  guildId String

  @@unique([userId, guildId])
}